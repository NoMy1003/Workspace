{
  "test_cases": [
    {
      "test_case_id": "TC001",
      "title": "成功登入 - 有效電子郵件與密碼",
      "precondition": "使用者已註冊有效帳號，並位於 /login 頁面。",
      "steps": [
        {
          "step_number": 1,
          "action": "輸入",
          "target_element": "電子郵件輸入框",
          "value": "test@example.com"
        },
        {
          "step_number": 2,
          "action": "輸入",
          "target_element": "密碼輸入框",
          "value": "password123"
        },
        {
          "step_number": 3,
          "action": "點擊",
          "target_element": "登入按鈕",
          "value": ""
        }
      ],
      "expected_result": "系統導向 /dashboard 首頁，並顯示「歡迎回來」的彈出訊息。"
    },
    {
      "test_case_id": "TC002",
      "title": "登入失敗 - 電子郵件格式不正確 (缺少 @ 符號)",
      "precondition": "使用者位於 /login 頁面。",
      "steps": [
        {
          "step_number": 1,
          "action": "輸入",
          "target_element": "電子郵件輸入框",
          "value": "testexample.com"
        },
        {
          "step_number": 2,
          "action": "輸入",
          "target_element": "密碼輸入框",
          "value": "password123"
        },
        {
          "step_number": 3,
          "action": "點擊",
          "target_element": "登入按鈕",
          "value": ""
        }
      ],
      "expected_result": "系統提示電子郵件格式錯誤，例如「請輸入有效的電子郵件地址」，且不進行頁面跳轉。"
    },
    {
      "test_case_id": "TC003",
      "title": "登入失敗 - 密碼長度不足 (少於 8 碼) 即時驗證",
      "precondition": "使用者位於 /login 頁面。",
      "steps": [
        {
          "step_number": 1,
          "action": "輸入",
          "target_element": "電子郵件輸入框",
          "value": "test@example.com"
        },
        {
          "step_number": 2,
          "action": "輸入",
          "target_element": "密碼輸入框",
          "value": "short"
        },
        {
          "step_number": 3,
          "action": "檢查",
          "target_element": "密碼輸入框下方錯誤訊息",
          "value": "密碼長度不足"
        }
      ],
      "expected_result": "密碼輸入框下方即時顯示紅字錯誤訊息「密碼長度不足」。"
    },
    {
      "test_case_id": "TC004",
